{
  "name": "github-repo-qa-bot",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Repo Q&A Bot — drop a GitHub URL, ingest top 50 small files (unauthenticated contents API, 60 req/hr), AST-chunk TS/JS, regex-chunk other langs, hybrid retrieval (BM25 + vector + RRF), streaming chat with [^c1] citations grounded in retrieved chunks. Per-file sidebar filter. \"Where is X used?\" lookup via whole-word regex match.",
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "test": "bun test",
    "db:push": "DATABASE_URL=\"$(pwd)/db/custom.db\" prisma db push --accept-data-loss",
    "db:generate": "DATABASE_URL=\"$(pwd)/db/custom.db\" prisma generate",
    "db:migrate": "DATABASE_URL=\"$(pwd)/db/custom.db\" prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tree-sitter": "^0.25.1",
    "tree-sitter-typescript": "^0.23.2",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
