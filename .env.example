# GitHub Repo Q&A Bot — environment variables
#
# Copy this file to `.env` (already created for you with the SQLite path)
# and fill in the optional values to enable real LLM + semantic embeddings.

# --- Prisma / SQLite (REQUIRED) ---
# Absolute path to the local SQLite database file. Prisma needs an absolute
# path on disk because it does not resolve relative paths against the
# project root reliably across `prisma db push` / `next dev` invocations.
DATABASE_URL=file:/home/z/my-project/apps/16-github-repo-qa-bot/db/custom.db

# --- LLM provider (OPTIONAL) ---
# When unset, the app falls back to a deterministic mock chat provider so
# the UI is demoable offline and tests stay deterministic.
# The z-ai-web-dev-sdk reads its own config from the sandbox — no env needed
# in production-sandbox runs. Set this to "1" to force the mock in prod too.
PKC_DISABLE_LLM=

# --- Embeddings provider (OPTIONAL) ---
# When unset, the app uses a deterministic hashing embedder (default in the
# sandbox and for tests). When set, an OpenAI-compatible embeddings endpoint
# is used and we fall back to hashing on any network failure.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small

# Alias — some deployments prefer the canonical OPENAI_API_KEY name.
OPENAI_API_KEY=
